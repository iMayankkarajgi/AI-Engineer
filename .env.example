# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Both values are safe to ship to the browser; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the Google OAuth client id. When set, Google sign-in runs from this site
# (so the Google screen shows the site name, not the Supabase address). Add the
# site's address under "Authorized JavaScript origins" for this client first.
VITE_GOOGLE_CLIENT_ID=

# Payments (server only; never prefix these with VITE_). Set them in Vercel.
# DODO_PAYMENTS_API_KEY=        secret API key from the Dodo Payments dashboard
# DODO_PAYMENTS_ENV=live        "live" or "test"
# DODO_WEBHOOK_SECRET=          signing secret of the webhook endpoint (whsec_...)
# SUPABASE_SERVICE_ROLE_KEY=    Supabase secret key (Project Settings → API keys)
